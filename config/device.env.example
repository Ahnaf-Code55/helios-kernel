# Copy to config/device.env and fill in.
# This repo does not clone a kernel until these are set.

# Marketing name, e.g. Pixel 8, Redmi Note 12
DEVICE_NAME=

# Android / Lineage / OEM codename, e.g. husky, tapas
DEVICE_CODENAME=

# SoC vendor: qcom | mtk | exynos | tensor | other
SOC_VENDOR=

# Chipset, e.g. SM8550, MT6789, Tensor G3
SOC_CHIPSET=

# Kernel version you intend to ship, e.g. 5.15, 6.1
KERNEL_VERSION=

# Git URL of the kernel tree that matches this phone
KERNEL_REPO=

# Branch or tag that matches the ROM you will boot
KERNEL_REF=

# Defconfig name inside the kernel tree
DEFCONFIG=

# arm64 for almost every modern phone
ARCH=arm64
